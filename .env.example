# ========================================================
# Daily Attendance - Environment Configuration
# ========================================================

# Application Configuration
NEXT_PUBLIC_APP_NAME="Daily Attendance"
NEXT_PUBLIC_APP_URL="https://your-vercel-app.vercel.app"
NODE_ENV="production"

# Database Configuration (MySQL online)
DB_HOST="your-db-host"
DB_PORT="3306"
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"
DB_NAME="daily_attendance"
DATABASE_URL="mysql://your-db-user:your-db-password@your-db-host:3306/daily_attendance"

# Authentication / JWT Secret
JWT_SECRET="change-this-secret-key"
JWT_EXPIRES_IN="7d"

# Nodemailer / SMTP Configuration (for password reset emails)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="your-email-user"
EMAIL_PASSWORD="your-email-password"
EMAIL_FROM="Daily Attendance <no-reply@yourdomain.com>"

# Default Seeded Admin Credentials (auto-seeded on first run)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-this-admin-password"

# Optional demo mode for local development only
NO_DATABASE="false"
USE_LOCAL_DATA="false"
ALLOW_DEMO_LOGIN="false"
